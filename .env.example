# Copia este archivo como .env (solo para probar en tu computadora).
# En el hosting, carga estas mismas variables en el panel de "Environment".

# Contraseña para entrar a la página (mínimo 12 caracteres).
# Genera una segura con:  openssl rand -base64 18
APP_PASSWORD=

# Cuenta de correo a vigilar (IMAP). Ejemplo para Gmail:
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=tu-correo@gmail.com
# En Gmail esto es una "contraseña de aplicación", no tu contraseña normal.
IMAP_PASS=

# Opcionales
IMAP_MAILBOX=INBOX
# Muestra también los correos de los últimos N minutos al abrir la página (0 = solo los nuevos).
LOOKBACK_MINUTES=0
# Solo mostrar correos cuyo remitente contenga alguno de estos textos, separados por coma.
# Ejemplo: FROM_FILTER=netflix.com,disneyplus.com
FROM_FILTER=
# Cuántos proxies hay delante del servidor (para detectar la IP real al bloquear intentos). En Render: 1.
# TRUST_PROXY=1
